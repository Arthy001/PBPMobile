<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp"
            android:background="@color/backgroundColor">

            <!-- Move Order Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveOrder"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Move Order"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/pastel1"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_move"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp"/>

            <!-- Picking Order Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickingOrder"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Picking Order"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/pastel2"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_shopping_cart"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Pick and Pack Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickAndPack"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Pick &amp; Pack (งานจัดแพ็ค)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="#FF9800"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_shopping_cart"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Receive to Shipping Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReceiveShipping"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="รับสินค้าเข้าจัดส่ง"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/pastel3"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_assignment"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Kanban Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKanban"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="RFID Loading"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/pastel4"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_dashboard"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Issue Delivery Order Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIssueDeliveryOrder"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="จัดส่งสินค้า"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/pastel5"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_local_shipping"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Find Product Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindProduct"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Find Product"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/pastel6"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_search"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Check Stock Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckStock"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Check Stock"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/pastel7"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_assignment"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Stock Count Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStockCount"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Stock Count"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/pastel7"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_assignment"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="12dp"/>

            <!-- Settings Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/gray"
                app:cornerRadius="16dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:rippleColor="@color/white"
                android:layout_marginBottom="20dp"/>

            <!-- Bluetooth Connection Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_connect"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/Connect"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/lightblue"
                    app:cornerRadius="12dp"
                    app:elevation="4dp"
                    app:icon="@drawable/ic_wifi"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_search"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/title_search"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:maxLines="2"
                    android:ellipsize="none"
                    app:backgroundTint="@color/blue2"
                    app:cornerRadius="12dp"
                    app:elevation="4dp"
                    app:icon="@drawable/ic_bluetooth_searching"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="6dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:gravity="center_vertical"
                android:background="@drawable/text_background"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <!-- Hidden view_menu for compatibility -->
            <LinearLayout
                android:id="@+id/view_menu"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="visible"/>
        </LinearLayout>
    </ScrollView>
    <!-- TabHost View - แยกออกมาจาก mainContent -->
    <LinearLayout
        android:id="@+id/view_tabhost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/white">

        <androidx.fragment.app.FragmentTabHost
            android:id="@android:id/tabhost"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:id="@+id/hScroller_mytabhostactivity"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:fadingEdge="none"
                    android:saveEnabled="false"
                    android:scrollbars="horizontal"
                    android:scrollbarSize="2dp">

                    <TabWidget
                        android:id="@android:id/tabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <FrameLayout
                    android:id="@android:id/tabcontent"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="0" />

                <FrameLayout
                    android:id="@+id/realtabcontent"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </androidx.fragment.app.FragmentTabHost>
    </LinearLayout>

    <!-- Login View -->
    <LinearLayout
        android:id="@+id/view_login"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="visible">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/app_logo"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PBP"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Username or Email"
                android:text=""
                android:inputType="textEmailAddress"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:text=""
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login"/>

        <TextView
            android:id="@+id/tvDeviceId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="-"/>
    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>
    </FrameLayout>

</FrameLayout>