<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/item_background_selector"
    android:layout_marginVertical="2dp">

    <!-- Header Row: TagNumber และ Status (ซ่อน) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTagNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tag: ABC123456789"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:ellipsize="middle"
            android:singleLine="true" />

        <!-- ซ่อน Status TextView -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Second Row: ItemType and AllocatedQty -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvItemType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Type: Full Box"
            android:textSize="12sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvQtyInBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Qty: 0.0"
            android:textSize="12sp"
            android:textColor="#666666"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvAllocatedQty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Qty: 0.0"
            android:textSize="12sp"
            android:textColor="#666666"
            android:gravity="end" />

    </LinearLayout>

</LinearLayout>