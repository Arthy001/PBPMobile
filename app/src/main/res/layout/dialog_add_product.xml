<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvProductNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="รหัสสินค้า: XXXX"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvBarcode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="บาร์โค้ด: XXXX"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvLot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lot: XXXX"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvLotNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="เลขที่ Lot: XXXX"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvMaxQty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="จำนวนสูงสุดที่เพิ่มได้: XX"
        android:textSize="14sp"
        android:textColor="#FF5722"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="จำนวน:"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="1"/>
    </LinearLayout>
</LinearLayout>