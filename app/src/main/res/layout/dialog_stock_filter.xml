<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="กรองสต็อก (Filter Stock)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>
        
        <!-- Product Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เลือกสินค้า (Products)"
            android:textStyle="bold"
            android:paddingTop="8dp"/>
        <Button
            android:id="@+id/btnSelectProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เลือกสินค้า... (All)"
            android:textAlignment="textStart"
            android:paddingStart="12dp"/>
        
        <!-- Product Group Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เลือกกลุ่มสินค้า (Product Groups)"
            android:textStyle="bold"
            android:paddingTop="12dp"/>
        <Button
            android:id="@+id/btnSelectProductGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เลือกกลุ่มสินค้า... (All)"
            android:textAlignment="textStart"
            android:paddingStart="12dp"/>
        
        <!-- Warehouse Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เลือกคลังสินค้า (Warehouse)"
            android:textStyle="bold"
            android:paddingTop="12dp"/>
        <Button
            android:id="@+id/btnSelectWarehouses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เลือกคลังสินค้า... (All)"
            android:textAlignment="textStart"
            android:paddingStart="12dp"/>
        
        <!-- Status Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="เลือกสถานะ (Status)"
            android:textStyle="bold"
            android:paddingTop="12dp"/>
        <Spinner
            android:id="@+id/spinnerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"/>
        
        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">
            
            <Button
                android:id="@+id/btnApplyFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Apply"
                android:backgroundTint="#4CAF50"/>
            
            <Button
                android:id="@+id/btnClearFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Clear"
                android:backgroundTint="#FF9800"/>
            
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Cancel"
                android:backgroundTint="#757575"/>
        </LinearLayout>
        
    </LinearLayout>
</ScrollView>
