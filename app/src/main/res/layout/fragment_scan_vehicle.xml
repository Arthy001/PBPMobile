<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <!-- AppBar Layout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/pastel5"
            app:contentInsetLeft="0dp"
            app:contentInsetStart="0dp"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@android:color/white"/>

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="จัดการรถด้วย RFID"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <!-- Notification Button with Badge -->
                <FrameLayout
                    android:id="@+id/notificationContainer"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:layout_marginEnd="48dp">

                    <ImageView
                        android:id="@+id/ivNotification"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="12dp"
                        android:src="@drawable/ic_notifications"
                        app:tint="@android:color/white"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvNotificationCount"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/notification_badge_background"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:visibility="gone"/>
                </FrameLayout>

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    app:iconifiedByDefault="true"
                    app:queryHint="ค้นหาทะเบียน/Tag..."
                    android:theme="@style/SearchViewStyle"/>
            </FrameLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Barcode Section -->
    <LinearLayout
        android:id="@+id/view_barcode"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/tvBarcode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="สแกน Barcode ที่นี่"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:background="@drawable/edittext_background"
            android:padding="12dp"
            android:gravity="center_vertical"/>

        <Button
            android:id="@+id/btnScanBarcode"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:drawableTop="@drawable/ic_scan"
            android:background="@drawable/button_background"/>

    </LinearLayout>

    <!-- Vehicle Info Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#E1F5FE"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="รถที่กำลังจัดการ:"
                android:textSize="12sp"
                android:textColor="#0277BD"/>

            <TextView
                android:id="@+id/tvTargetInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="กรุณาสแกน Tag รถ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#01579B"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kanban"
                android:textSize="12sp"
                android:textColor="#0277BD"/>

            <TextView
                android:id="@+id/tvTotalKanbanCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#01579B"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Quantity Information Section (Row 1: Kanban, DO, Pallet) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#F5F5F5">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kanban"
                android:textSize="10sp"
                android:textColor="@android:color/darker_gray"/>
            <TextView
                android:id="@+id/tvTotalKanbanCountSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0277BD"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total DO"
                android:textSize="10sp"
                android:textColor="@android:color/darker_gray"/>
            <TextView
                android:id="@+id/tvTotalDO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#311B92"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Pallet"
                android:textSize="10sp"
                android:textColor="@android:color/darker_gray"/>
            <TextView
                android:id="@+id/tvTotalPallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#00695C"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Quantity Information Section (Row 2: Qty, Success, Scan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="#F5F5F5">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Qty"
                android:textSize="10sp"
                android:textColor="@android:color/darker_gray"/>
            <TextView
                android:id="@+id/tvTotalQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Success"
                android:textSize="10sp"
                android:textColor="@android:color/darker_gray"/>
            <TextView
                android:id="@+id/tvTotalSuccessSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan"
                android:textSize="10sp"
                android:textColor="@android:color/darker_gray"/>
            <TextView
                android:id="@+id/tvTotalScanSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF9800"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden Views for RFID Logic -->
    <LinearLayout
        android:id="@+id/view_readtag"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible">
        <TextView android:id="@+id/tv_count" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tv_time" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tv_total" android:layout_width="0dp" android:layout_height="0dp" />
        <EditText
            android:id="@+id/etTime"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:hint="99999999"
            android:inputType="numberDecimal"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- ListView Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="0.5dp"
            android:padding="3dp"/>

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_empty_box"
                android:alpha="0.5"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ยังไม่มีข้อมูลสแกน"
                android:textSize="16sp"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Manual Read Section -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnRead2"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:drawableTop="@drawable/ic_scan"
                android:background="@drawable/button_background"/>

            <EditText
                android:id="@+id/EtData_Read"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:hint="สแกน Tag รถ"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:background="@drawable/edittext_background"
                android:paddingLeft="12dp"
                android:gravity="center_vertical"/>

            <Button
                android:id="@+id/btnRead"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:drawableTop="@drawable/ic_scan"
                android:background="@drawable/button_background"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/viewAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="1dp">

            <Button
                android:id="@+id/btnScanRFID"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:drawableTop="@drawable/ic_play"
                android:paddingTop="12dp"
                android:paddingBottom="0dp"
                android:textSize="0sp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:drawableTop="@drawable/ic_stop"
                android:paddingTop="12dp"
                android:paddingBottom="3dp"
                android:textSize="0sp"/>
            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:drawableTop="@drawable/ic_refresh"
                android:paddingTop="12dp"
                android:paddingBottom="3dp"
                android:textSize="0sp"/>

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:drawableTop="@drawable/ic_save"
                android:paddingTop="12dp"
                android:paddingBottom="3dp"
                android:textSize="0sp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
